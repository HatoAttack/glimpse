<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI に依存しない中核部分（画像読み込み・サムネイル・コマンドの仕組み・編集処理） -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ImageViewer.Core</RootNamespace>
    <!-- WIC（HEIC / AVIF / RAW 等）の読み込みに WPF の画像 API を使う。自己完結ビルドには元々同梱されるので exe サイズは増えない -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />
  </ItemGroup>

</Project>
