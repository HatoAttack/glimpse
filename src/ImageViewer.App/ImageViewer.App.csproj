<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ImageViewer.App</RootNamespace>
    <AssemblyName>Glimpse</AssemblyName>
    <Product>Glimpse</Product>
    <ApplicationIcon>Glimpse.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- exe のアイコン（ApplicationIcon）と同じものを、ウィンドウのアイコン用に埋め込む -->
    <EmbeddedResource Include="Glimpse.ico" LogicalName="Glimpse.ico" />
    <!-- ☰ → ヘルプ →「ライセンス」で出す（exe だけを配っても、ライセンス文と著作権表示が一緒に届くように） -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- .NET Runtime を同梱するビルド（リリースの exe）では、同梱した版の .NET Runtime の Third-party notices も埋め込む。
       修正版ごとに中身が変わるので、THIRD-PARTY-NOTICES.txt に写さず、publish で使う runtime pack のものをそのまま使う -->
  <Target Name="EmbedRuntimeNotices" AfterTargets="ResolveFrameworkReferences" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_RuntimeNotices Include="@(ResolvedRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <EmbeddedResource Include="@(_RuntimeNotices)" LogicalName="RUNTIME-THIRD-PARTY-NOTICES.txt" />
    </ItemGroup>
    <Error Condition="'@(_RuntimeNotices)' == '' Or !Exists('@(_RuntimeNotices)')" Text=".NET Runtime の THIRD-PARTY-NOTICES.TXT が runtime pack に見つかりません（@(_RuntimeNotices)）" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\ImageViewer.Core\ImageViewer.Core.csproj" />
  </ItemGroup>

</Project>
