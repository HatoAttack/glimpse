<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ImageViewer.App</RootNamespace>
    <AssemblyName>Glimpse</AssemblyName>
    <Product>Glimpse</Product>
    <ApplicationIcon>Glimpse.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- exe のアイコン（ApplicationIcon）と同じものを、ウィンドウのアイコン用に埋め込む -->
    <EmbeddedResource Include="Glimpse.ico" LogicalName="Glimpse.ico" />
    <!-- ☰ → ヘルプ →「ライセンス」で出す（exe だけを配っても、ライセンス文と著作権表示が一緒に届くように） -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImageViewer.Core\ImageViewer.Core.csproj" />
  </ItemGroup>

</Project>
