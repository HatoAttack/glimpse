<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- テスト用の HEIC / JPEG XL を作るのに WinRT のエンコーダを使う（テストのみ。本体は net10.0-windows のまま） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- テスト用の画像の読み書きに WIC（WPF の画像 API）を使う（ImageSharp にも Skia にも頼らずに、正解を作って確かめるため） -->
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWPF を付けると外れるので戻す（WPF の Path と名前がぶつかるが、テストでは WPF の図形を使わない） -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ImageViewer.Core\ImageViewer.Core.csproj" />
    <ProjectReference Include="..\..\src\ImageViewer.App\ImageViewer.App.csproj" />
  </ItemGroup>

</Project>
